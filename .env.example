# Server-only Neon database; do not commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/careflow?sslmode=verify-full
# REQUIRED in production (at least 8 characters; never use 2468).
# Store only in Vercel encrypted/sensitive Environment Variables, not GitHub files.
STAFF_PIN=replace-with-a-strong-private-pin
# Forecasting is local and deterministic; no external prediction URL is required.
# Optional real automatic email reminders (day before appointment at 8:00am IST).
# Use a verified sending domain and opt-in patient email. Never commit secrets.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Secret needed to authenticate Vercel Cron HTTP requests.
CRON_SECRET=

# Optional UUIDv4 of an existing shared demo room. Unset uses one stable default.
DEFAULT_ROOM_ID=
